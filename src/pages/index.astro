---
import Main from "../layouts/Main.astro";
import Cards from "../components/Cards.astro";
import PersonSchema from "../components/PersonSchema.astro";

const profilePicture = "/images/profile.jpg"
const description = "Cristian Ungureanu, freelance React developer based in Bucharest, Romania. 10+ years of experience building web applications with React, JavaScript, and WordPress. Available for hire.";
---
<Main title="Cristian Ungureanu | Freelance React & Frontend Developer" description={description}>
	<PersonSchema />
	<div class="profile">
		<img alt="Cristian Ungureanu, freelance React and frontend developer" width="160" height="160" src={profilePicture} class="profile__picture" fetchpriority="high" />
		<div class="profile__details">
			<h1>Cristian Ungureanu</h1>
			<h2>Freelance React Developer &amp; Software Developer at EveryMatrix</h2>
			<p>
				Frontend developer with 10+ years of hands-on experience building and
				maintaining web applications. Strong background in React and other
				modern JavaScript frameworks, UI architecture, and automated testing.
				Available for freelance work.
			</p>
		</div>
	</div>
	<Cards cards={[
		{
			title: "Get to know me",
			gradientFrom: "#93c5fd",
			gradientTo: "#60a5fa",
			to: "/about"
		},
		{
			title: "A summary of my work history",
			gradientFrom: "#fde68a",
			gradientTo: "#fca5a5",
			to: "/experience"
		},
		{
			title: "Projects I've built",
			gradientFrom: "#818cf8",
			gradientTo: "#d8b4fe",
			to: "/projects"
		},
		{
			title: "What I do beyond technology",
			gradientFrom: "#6ee7b7",
			gradientTo: "#9333ea",
			to: "/beyond-tech"
		},
	]}/>
</Main>

<style>
  .profile {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 1rem 0 3rem 0;
  }

  .profile__details {
    flex: 1 0 300px;
  }

  .profile__details > h1 {
    margin-top: 0;
  }

  .profile__picture {
    border-radius: 50%;
    margin: 0 2rem 1rem 0;
    object-fit: cover;
  }
</style>
