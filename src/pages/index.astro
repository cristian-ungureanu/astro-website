---
import Main from "../layouts/Main.astro";
import Cards from "../components/Cards.astro";

const profilePicture = "/images/profile.jpg"
---
<Main title="Cristian Ungureanu">
	<div class="profile">
		<img alt="Cristian Ungureanu" width="160px" height="160px" src={profilePicture} class="profile__picture" />
		<div class="profile__details">
			<h1>Cristian Ungureanu</h1>
			<h2>Software Developer at EveryMatrix</h2>
			<p>
				Frontend Developer with 10+ years of hands-on experience building and
				maintaining scalable web applications. Strong background in modern
				JavaScript frameworks, UI architecture, and automated testing.
			</p>
		</div>
	</div>
	<Cards cards={[
		{
			title: "Get to know me",
			gradientFrom: "#93c5fd",
			gradientTo: "#60a5fa",
			to: "/about"
		},
		{
			title: "A summary of my work history",
			gradientFrom: "#fde68a",
			gradientTo: "#fca5a5",
			to: "/experience"
		},
		{
			title: "Projects I've built",
			gradientFrom: "#818cf8",
			gradientTo: "#d8b4fe",
			to: "/projects"
		},
		{
			title: "What I do beyond technology",
			gradientFrom: "#6ee7b7",
			gradientTo: "#9333ea",
			to: "/beyond-tech"
		},
	]}/>
</Main>

<style>
  .profile {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 1rem 0 3rem 0;
  }

  .profile__details {
    flex: 1 0 300px;
  }

  .profile__details > h1 {
    margin-top: 0;
  }

  .profile__picture {
    border-radius: 50%;
    margin: 0 2rem 1rem 0;
    object-fit: cover;
  }
</style>
