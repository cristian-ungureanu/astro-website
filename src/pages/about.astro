---
import Main from "../layouts/Main.astro";
import PageHeader from "../components/PageHeader.astro";

const skills = [
	"React.js", "JavaScript", "TypeScript", "Svelte", "Stencil",
	"AngularJS", "Vue.js", "HTML & CSS", "PHP", "WordPress",
	"Playwright (E2E)", "PHPUnit",
];

const education = [
	{
		school: "Universitatea Politehnica din București",
		details: "Artificial Intelligence (2011 – 2015, not finished)",
	},
	{
		school: 'Colegiul Național "Spiru Haret" București',
		details: "High School Diploma — Mathematics and Computer Science (2007 – 2011)",
	},
];

const certifications = [
	"Automated Web Testing with JavaScript and Playwright — Udemy (Oct 2023)",
	"PHP Unit Testing with PHPUnit — Udemy (Oct 2023)",
	"Complete Intro to React v8 — Frontend Masters (Dec 2022)",
	"Cyber Security — Brightway (Dec 2022)",
	"Mastering Communication Skills — Attitude Training (Apr 2022)",
	"Middle & First Time Managers — Brightway (Feb 2022)",
	"New Adventures in Frontend — Smashing Conferences (Feb 2022)",
];
---
<Main title="Cristian Ungureanu | About">
	<PageHeader
		title="About"
		subtitle="A bit more about who I am, what I know, and where I learned it."
		poster="/images/philosophies.jpg"
	/>

	<p>
		I'm a Frontend Developer based in Bucharest, Romania, with 10+ years
		of hands-on experience building and maintaining scalable web
		applications. My background spans modern JavaScript frameworks, UI
		architecture, and automated testing, and I'm comfortable working in
		fast-paced product teams — contributing beyond development through
		QA, support, and release coordination.
	</p>

	<h3>Skills</h3>
	<ul class="skills">
		{skills.map((skill) => <li class="skills__item">{skill}</li>)}
	</ul>

	<h3>Education</h3>
	<ul>
		{education.map((entry) => (
			<li>
				<strong>{entry.school}</strong><br />
				{entry.details}
			</li>
		))}
	</ul>

	<h3>Languages</h3>
	<ul>
		<li><strong>Romanian</strong> — Native</li>
		<li><strong>English</strong> — Upper-Intermediate</li>
	</ul>

	<h3>Courses & Certifications</h3>
	<ul>
		{certifications.map((entry) => <li>{entry}</li>)}
	</ul>

	<h3>Get in touch</h3>
	<ul>
		<li>Email: <a href="mailto:cungureanu902@gmail.com">cungureanu902@gmail.com</a></li>
		<li>Phone: <a href="tel:+40771189061">+40 771-189-061</a></li>
		<li>LinkedIn: <a href="https://linkedin.com/in/cristi-ungureanu" target="_blank" rel="noopener noreferrer">linkedin.com/in/cristi-ungureanu</a></li>
		<li>GitHub: <a href="https://github.com/cristian-ungureanu" target="_blank" rel="noopener noreferrer">github.com/cristian-ungureanu</a></li>
		<li>Location: Bucharest, Romania</li>
	</ul>

	<p>
		Outside of work, I share my home with 3 cats, a dog, and a
		daughter who runs the place. Raising her is the hardest thing
		I've ever done, and easily the most rewarding.
	</p>
</Main>

<style>
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		list-style: none;
	}

	.skills__item {
		--chip-from: var(--grad-1-from);
		--chip-to: var(--grad-1-to);
		margin: 0;
		padding: 0.4rem 0.9rem;
		background: linear-gradient(to right,
			color-mix(in srgb, var(--chip-from) 25%, transparent),
			color-mix(in srgb, var(--chip-to) 25%, transparent));
		border: 1px solid color-mix(in srgb, var(--chip-to) 45%, transparent);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--gray-900);
		transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out;
	}

	.skills__item:nth-child(4n+2) {
		--chip-from: var(--grad-2-from);
		--chip-to: var(--grad-2-to);
	}

	.skills__item:nth-child(4n+3) {
		--chip-from: var(--grad-3-from);
		--chip-to: var(--grad-3-to);
	}

	.skills__item:nth-child(4n) {
		--chip-from: var(--grad-4-from);
		--chip-to: var(--grad-4-to);
	}

	.skills__item:hover {
		background: linear-gradient(to right,
			color-mix(in srgb, var(--chip-from) 40%, transparent),
			color-mix(in srgb, var(--chip-to) 40%, transparent));
		border-color: color-mix(in srgb, var(--chip-to) 65%, transparent);
	}
</style>
