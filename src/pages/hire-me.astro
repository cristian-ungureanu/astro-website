---
import Main from "../layouts/Main.astro";
import PageHeader from "../components/PageHeader.astro";

const FORM_ENDPOINT = "https://formspree.io/f/xvkpjkkk";
const description = "Hire a freelance React and frontend developer for your next project. Based in Bucharest, Romania, available remotely for web development, WordPress, and custom builds.";
---
<Main title="Cristian Ungureanu | Hire a Freelance React Developer" description={description}>
	<PageHeader
		title="Hire Me"
		subtitle="Looking for a frontend developer for your next project? Tell me a bit about it and I'll get back to you."
	/>

	<p>
		I'm available for freelance work, everything from one-off features
		and bug fixes to full frontend builds. Fill out the form below and
		I'll reply as soon as I can, usually within a day or two.
	</p>

	<form id="hire-form" class="form" data-endpoint={FORM_ENDPOINT}>
		<div class="form__row">
			<label class="form__label" for="name">Name</label>
			<input class="form__input" type="text" id="name" name="name" aria-describedby="name-error" required />
			<span class="form__error" id="name-error" role="alert"></span>
		</div>

		<div class="form__row">
			<label class="form__label" for="email">Email</label>
			<input class="form__input" type="email" id="email" name="email" aria-describedby="email-error" required />
			<span class="form__error" id="email-error" role="alert"></span>
		</div>

		<div class="form__row">
			<label class="form__label" for="company">Company <span class="form__optional">(optional)</span></label>
			<input class="form__input" type="text" id="company" name="company" aria-describedby="company-error" />
			<span class="form__error" id="company-error" role="alert"></span>
		</div>

		<div class="form__row">
			<label class="form__label" for="budget">Budget <span class="form__optional">(optional)</span></label>
			<select class="form__input" id="budget" name="budget" aria-describedby="budget-error">
				<option value="">Not sure yet</option>
				<option value="< $1,000">Less than $1,000</option>
				<option value="$1,000 - $5,000">$1,000 - $5,000</option>
				<option value="$5,000+">$5,000+</option>
			</select>
			<span class="form__error" id="budget-error" role="alert"></span>
		</div>

		<div class="form__row">
			<label class="form__label" for="message">Tell me about your project</label>
			<textarea class="form__input" id="message" name="message" rows="6" aria-describedby="message-error" required></textarea>
			<span class="form__error" id="message-error" role="alert"></span>
		</div>

		<!-- Honeypot field, hidden from real visitors, used by Formspree to catch spam bots. -->
		<input type="text" name="_gotcha" class="form__honeypot" tabindex="-1" autocomplete="off" />

		<button class="form__submit" type="submit">Send message</button>

		<p class="form__status" role="status" aria-live="polite"></p>
	</form>

	<h3>Prefer email?</h3>
	<ul>
		<li>Email: <a href="mailto:cungureanu902@gmail.com">cungureanu902@gmail.com</a></li>
		<li>LinkedIn: <a href="https://linkedin.com/in/cristi-ungureanu" target="_blank" rel="noopener noreferrer">linkedin.com/in/cristi-ungureanu</a></li>
	</ul>
</Main>

<style>
	.form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin: 2rem 0;
	}

	.form__row {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form__label {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--gray-900);
	}

	.form__optional {
		font-weight: 400;
		opacity: 0.6;
	}

	.form__input {
		font: inherit;
		font-size: 1rem;
		color: var(--gray-900);
		background: var(--background);
		border: 1px solid color-mix(in srgb, var(--gray-400) 40%, transparent);
		border-radius: 10px;
		padding: 0.65rem 0.8rem;
	}

	.form__input:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 1px;
	}

	.form__input[aria-invalid="true"] {
		border-color: #dc2626;
	}

	.form__error {
		min-height: 1.1rem;
		font-size: 0.85rem;
		color: #dc2626;
	}

	.form__error:empty {
		display: none;
	}

	textarea.form__input {
		resize: vertical;
	}

	.form__honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.form__submit {
		align-self: flex-start;
		font: inherit;
		font-size: 1rem;
		font-weight: 500;
		color: var(--gray-900);
		cursor: pointer;
		padding: 0.7rem 1.5rem;
		border: none;
		border-radius: 10px;
		background: linear-gradient(to right, var(--grad-3-from), var(--grad-3-to));
		transition: transform 0.2s ease-in-out;
	}

	.form__submit:hover {
		transform: scale(0.97);
	}

	.form__submit:disabled {
		opacity: 0.6;
		cursor: not-allowed;
		transform: none;
	}

	.form__status {
		margin: 0;
		font-size: 0.9rem;
	}

	.form__status[data-state="success"] {
		color: #16a34a;
	}

	.form__status[data-state="error"] {
		color: #dc2626;
	}
</style>

<script>
	type FormspreeError = { field?: string; message: string; code?: string };
	type FormspreeResponse = { errors?: FormspreeError[] };

	const form = document.querySelector<HTMLFormElement>("#hire-form");
	const status = form?.querySelector<HTMLParagraphElement>(".form__status");
	const submitButton = form?.querySelector<HTMLButtonElement>(".form__submit");
	const fieldNames = ["name", "email", "company", "budget", "message"];

	const clearErrors = () => {
		for (const fieldName of fieldNames) {
			const errorEl = form?.querySelector<HTMLSpanElement>(`#${fieldName}-error`);
			const fieldEl = form?.elements.namedItem(fieldName) as HTMLElement | null;
			if (errorEl) errorEl.textContent = "";
			fieldEl?.removeAttribute("aria-invalid");
		}
	};

	const showFieldErrors = (errors: FormspreeError[]) => {
		const generalMessages: string[] = [];

		for (const { field, message } of errors) {
			const errorEl = field ? form?.querySelector<HTMLSpanElement>(`#${field}-error`) : null;
			const fieldEl = field ? (form?.elements.namedItem(field) as HTMLElement | null) : null;

			if (errorEl && fieldEl) {
				errorEl.textContent = message;
				fieldEl.setAttribute("aria-invalid", "true");
			} else {
				generalMessages.push(message);
			}
		}

		if (status && generalMessages.length > 0) {
			status.textContent = generalMessages.join(" ");
			status.dataset.state = "error";
		} else if (status) {
			status.textContent = "Please fix the highlighted fields and try again.";
			status.dataset.state = "error";
		}
	};

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const endpoint = form.dataset.endpoint;

		if (submitButton) submitButton.disabled = true;
		clearErrors();
		if (status) {
			status.textContent = "Sending...";
			status.dataset.state = "";
		}

		try {
			const response = await fetch(endpoint!, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});

			if (response.ok) {
				form.reset();
				if (status) {
					status.textContent = "Thanks! Your message has been sent. I'll be in touch soon.";
					status.dataset.state = "success";
				}
			} else {
				const data: FormspreeResponse = await response.json().catch(() => ({}));
				if (data.errors?.length) {
					showFieldErrors(data.errors);
				} else {
					throw new Error("Request failed");
				}
			}
		} catch {
			if (status) {
				status.textContent = "Something went wrong. Please email me directly instead.";
				status.dataset.state = "error";
			}
		} finally {
			if (submitButton) submitButton.disabled = false;
		}
	});
</script>
