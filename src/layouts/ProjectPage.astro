---
import type { MarkdownLayoutProps } from "astro";
import Main from "./Main.astro";
import PageHeader from "../components/PageHeader.astro";

type Props = MarkdownLayoutProps<{
    title: string;
    subtitle: string;
    poster?: string;
    video?: string;
    imageAlt?: string;
}>

const { title, subtitle, poster, video, imageAlt } = Astro.props.frontmatter;
---

<Main title={`Cristian Ungureanu | ${title}`} description={subtitle} image={poster} type="article">
    <a href="/projects" class="back-link">&larr; Back to projects</a>
    <PageHeader title={title} subtitle={subtitle} poster={poster} video={video} imageAlt={imageAlt} />
    <slot />
</Main>

<style>
    .back-link {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--gray-400);
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
    }

    .back-link:hover {
        color: var(--gray-900);
    }
</style>
