---
import type { MarkdownLayoutProps } from "astro";
import Main from "./Main.astro";
import PageHeader from "../components/PageHeader.astro";

type Props = MarkdownLayoutProps<{
    title: string;
    subtitle: string;
    poster?: string;
    imageAlt?: string;
}>

const { title, subtitle, poster, imageAlt } = Astro.props.frontmatter;
---

<Main title={`Cristian Ungureanu | ${title}`} description={subtitle} image={poster}>
    <PageHeader title={title} subtitle={subtitle} poster={poster} imageAlt={imageAlt} />
    <slot />
</Main>