---
// Replace with your GA4 Measurement ID (analytics.google.com -> Admin -> Data Streams -> your stream).
const GA_MEASUREMENT_ID = "G-XXXXXXXXXX";
---
<div class="consent-banner" id="consent-banner" hidden>
	<p class="consent-banner__text">
		This site uses Google Analytics to see how visitors find and use it. Nothing loads until you accept.
	</p>
	<div class="consent-banner__actions">
		<button class="consent-banner__button consent-banner__button--decline" id="consent-decline" type="button">Decline</button>
		<button class="consent-banner__button consent-banner__button--accept" id="consent-accept" type="button">Accept</button>
	</div>
</div>

<style>
	.consent-banner {
		position: fixed;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		z-index: 100;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		max-width: 40rem;
		margin: 0 auto;
		padding: 1rem 1.25rem;
		border-radius: 10px;
		border: 1px solid color-mix(in srgb, var(--gray-400) 40%, transparent);
		background: var(--background);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
	}

	.consent-banner__text {
		flex: 1 1 260px;
		margin: 0;
		font-size: 0.9rem;
		color: var(--gray-900);
		opacity: 0.85;
	}

	.consent-banner__actions {
		display: flex;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.consent-banner__button {
		font: inherit;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		padding: 0.5rem 1rem;
		border-radius: 10px;
		border: 1px solid color-mix(in srgb, var(--gray-400) 40%, transparent);
		background: none;
		color: var(--gray-900);
		transition: transform 0.2s ease-in-out;
	}

	.consent-banner__button:hover {
		transform: scale(0.97);
	}

	.consent-banner__button--accept {
		border: none;
		background: linear-gradient(to right, var(--grad-3-from), var(--grad-3-to));
	}
</style>

<script define:vars={{ GA_MEASUREMENT_ID }}>
	const CONSENT_KEY = "analytics-consent";

	function loadGoogleAnalytics(id) {
		if (!id || id.includes("XXXXXXXXXX")) return;

		const script = document.createElement("script");
		script.async = true;
		script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
		document.head.appendChild(script);

		window.dataLayer = window.dataLayer || [];
		function gtag() { window.dataLayer.push(arguments); }
		window.gtag = gtag;
		gtag("js", new Date());
		gtag("config", id, { anonymize_ip: true });
	}

	const consent = localStorage.getItem(CONSENT_KEY);

	if (consent === "granted") {
		loadGoogleAnalytics(GA_MEASUREMENT_ID);
	} else if (consent !== "denied") {
		const banner = document.getElementById("consent-banner");
		banner?.removeAttribute("hidden");

		document.getElementById("consent-accept")?.addEventListener("click", () => {
			localStorage.setItem(CONSENT_KEY, "granted");
			loadGoogleAnalytics(GA_MEASUREMENT_ID);
			banner?.setAttribute("hidden", "");
		});

		document.getElementById("consent-decline")?.addEventListener("click", () => {
			localStorage.setItem(CONSENT_KEY, "denied");
			banner?.setAttribute("hidden", "");
		});
	}
</script>
