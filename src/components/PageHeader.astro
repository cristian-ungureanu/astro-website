---
type Props = {
    title: string;
    subtitle: string;
    poster: string | undefined;
    video: string | undefined;
}

const { title, subtitle, poster, video } = Astro.props;
---

{video && (
    <figure class="figure">
        <video src={video} poster={poster} controls playsinline preload="metadata" class="figure__image">
        </video>
    </figure>
)}
{!video && poster && (
    <figure class="figure">
        <img src={poster} alt={title} class="figure__image">
    </figure>
)}

<h1>{title}</h1>
<h2>{subtitle}</h2>

<style>
    h1 + h2 {
        margin-bottom: 3rem;
    }

    .figure {
        margin: 0;
    }

    .figure__image {
        width: 100%;
        height: auto;
        border-radius: 10px;
    }
</style>
